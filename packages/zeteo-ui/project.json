{
  "name": "zeteo-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/zeteo-ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build && vite build -c vite.mcp-card.config.ts",
        "cwd": "packages/zeteo-ui"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/dist-mcp"]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit && node scripts/check-routes.mjs",
        "cwd": "packages/zeteo-ui"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "packages/zeteo-ui"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/zeteo-ui"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist dist-mcp node_modules/.vite tsconfig.tsbuildinfo",
        "cwd": "packages/zeteo-ui"
      }
    }
  }
}
