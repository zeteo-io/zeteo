{
  "version": "0.1.0",
  "service": {
    "slug": "zeteo",
    "name": "Zeteo",
    "secretFrom": "TEREO_CLIENT_SECRET",
    "access": {
      "roles": [
        "audit_writer",
        "user_resolver",
        "group_resolver"
      ]
    },
    "permissions": [
      {
        "name": "zeteo.sources.read",
        "displayName": "Read sources",
        "description": "List and read the sources zeteo knows about",
        "orgAssignable": false
      },
      {
        "name": "zeteo.sources.write",
        "displayName": "Manage sources",
        "description": "Register, change, archive and refresh sources, and declare relations; also grants Read sources",
        "orgAssignable": false
      },
      {
        "name": "zeteo.grants.read",
        "displayName": "Read grants",
        "description": "List and read who may query which tables and columns, and users' and groups' concurrency limits; also lets the holder look up users' names and email addresses",
        "orgAssignable": false
      },
      {
        "name": "zeteo.grants.write",
        "displayName": "Manage grants",
        "description": "Create, change and remove grants and concurrency limits; also grants Read grants",
        "orgAssignable": false
      },
      {
        "name": "zeteo.data.read",
        "displayName": "Query data",
        "description": "Run queries over the tables and columns one is granted",
        "orgAssignable": false
      },
      {
        "name": "zeteo.data.export",
        "displayName": "Export data",
        "description": "Export query results over the tables and columns one is granted, from sources that allow it",
        "orgAssignable": false
      },
      {
        "name": "zeteo.runs.read",
        "displayName": "Read query runs",
        "description": "List the record of queries that were run; also lets the holder look up users' names and email addresses",
        "orgAssignable": false
      },
      {
        "name": "zeteo.mcp.use",
        "displayName": "Use over MCP",
        "description": "Use zeteo through an AI connected over MCP",
        "orgAssignable": false
      },
      {
        "name": "zeteo.saved_queries.read",
        "displayName": "Read saved queries",
        "description": "List and read every user's saved queries and who they are shared with; also lets the holder look up users' names and email addresses",
        "orgAssignable": false
      },
      {
        "name": "zeteo.saved_queries.write",
        "displayName": "Manage saved queries",
        "description": "Change, share, transfer and delete any user's saved queries; also grants Read saved queries",
        "orgAssignable": false
      },
      {
        "name": "zeteo.dashboards.read",
        "displayName": "Read dashboards",
        "description": "List and read every user's dashboards and saved panels and who they are shared with",
        "orgAssignable": false
      },
      {
        "name": "zeteo.dashboards.write",
        "displayName": "Manage dashboards",
        "description": "Change, share, transfer and delete any user's dashboards and saved panels; also grants Read dashboards",
        "orgAssignable": false
      },
      {
        "name": "zeteo.uploads.write",
        "displayName": "Manage upload sources",
        "description": "Create upload sources from uploaded files, and manage and grant the ones the holder owns",
        "orgAssignable": false
      },
      {
        "name": "zeteo.measures.write",
        "displayName": "Manage measures",
        "description": "Create, change and delete measures: named group-level calculations that queries on a source can use",
        "orgAssignable": false
      },
      {
        "name": "zeteo.calendar.write",
        "displayName": "Manage the calendar",
        "description": "Change the working days, holidays, fiscal year start and time zone that dates and business-day functions use",
        "orgAssignable": false
      }
    ],
    "systemRoles": [
      {
        "name": "zeteo_admin",
        "displayName": "Zeteo administrator",
        "description": "Manages sources, grants, saved queries, dashboards and the record of query runs",
        "permissions": [
          "zeteo.sources.read",
          "zeteo.sources.write",
          "zeteo.grants.read",
          "zeteo.grants.write",
          "zeteo.data.read",
          "zeteo.data.export",
          "zeteo.runs.read",
          "zeteo.mcp.use",
          "zeteo.saved_queries.read",
          "zeteo.saved_queries.write",
          "zeteo.dashboards.read",
          "zeteo.dashboards.write",
          "zeteo.uploads.write",
          "zeteo.measures.write",
          "zeteo.calendar.write"
        ]
      },
      {
        "name": "zeteo_user",
        "displayName": "Zeteo user",
        "description": "Queries the data they are granted",
        "permissions": [
          "zeteo.data.read",
          "zeteo.measures.write"
        ]
      },
      {
        "name": "zeteo_mcp_user",
        "displayName": "Zeteo MCP user",
        "description": "Queries the data they are granted, also through an AI connected over MCP",
        "permissions": [
          "zeteo.data.read",
          "zeteo.mcp.use"
        ]
      }
    ],
    "eventTypes": [
      {
        "eventType": "zeteo.source.created",
        "description": "A source was registered, or an upload source created from an upload",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.updated",
        "description": "A source's settings, limits, descriptions, name or columns were changed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.archived",
        "description": "A source was archived",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.refreshed",
        "description": "A source's catalogue was refreshed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.deleted",
        "description": "An upload source and its stored tables were deleted",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.transferred",
        "description": "An upload source was transferred to another owner",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.tables_added",
        "description": "Tables were added to an upload source from an upload",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.table_reuploaded",
        "description": "An upload source's table was replaced by a new upload",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.table_removed",
        "description": "A table was removed from an upload source",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.merged_table_saved",
        "description": "A merged table of an upload source was created or changed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.connection.updated",
        "description": "The Google service-account key was set or replaced",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.relation.declared",
        "description": "A relation was declared between two tables",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.relation.renamed",
        "description": "A relation was renamed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.relation.removed",
        "description": "A declared relation was removed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.grant.created",
        "description": "A grant to a table was created",
        "readPermission": "zeteo.grants.read"
      },
      {
        "eventType": "zeteo.grant.updated",
        "description": "A grant's columns were changed",
        "readPermission": "zeteo.grants.read"
      },
      {
        "eventType": "zeteo.grant.removed",
        "description": "A grant was removed",
        "readPermission": "zeteo.grants.read"
      },
      {
        "eventType": "zeteo.principal_limit.created",
        "description": "A user or group was given its own concurrency limits",
        "readPermission": "zeteo.grants.read"
      },
      {
        "eventType": "zeteo.principal_limit.updated",
        "description": "A user's or group's concurrency limits were changed",
        "readPermission": "zeteo.grants.read"
      },
      {
        "eventType": "zeteo.principal_limit.removed",
        "description": "A user's or group's own concurrency limits were removed",
        "readPermission": "zeteo.grants.read"
      },
      {
        "eventType": "zeteo.saved_query.created",
        "description": "A saved query was created",
        "readPermission": "zeteo.saved_queries.read"
      },
      {
        "eventType": "zeteo.saved_query.updated",
        "description": "A saved query was changed",
        "readPermission": "zeteo.saved_queries.read"
      },
      {
        "eventType": "zeteo.saved_query.deleted",
        "description": "A saved query was deleted",
        "readPermission": "zeteo.saved_queries.read"
      },
      {
        "eventType": "zeteo.saved_query.shared",
        "description": "A saved query's shares were changed",
        "readPermission": "zeteo.saved_queries.read"
      },
      {
        "eventType": "zeteo.saved_query.transferred",
        "description": "A saved query was transferred to another owner",
        "readPermission": "zeteo.saved_queries.read"
      },
      {
        "eventType": "zeteo.saved_query.copied",
        "description": "A saved query was copied",
        "readPermission": "zeteo.saved_queries.read"
      },
      {
        "eventType": "zeteo.dashboard.created",
        "description": "A dashboard was created",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.dashboard.updated",
        "description": "A dashboard was changed",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.dashboard.deleted",
        "description": "A dashboard was deleted",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.dashboard.shared",
        "description": "A dashboard's shares were changed",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.dashboard.transferred",
        "description": "A dashboard was transferred to another owner",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.dashboard.copied",
        "description": "A dashboard was copied",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.saved_panel.created",
        "description": "A saved panel was created",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.saved_panel.updated",
        "description": "A saved panel was changed",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.saved_panel.deleted",
        "description": "A saved panel was deleted",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.saved_panel.shared",
        "description": "A saved panel's shares were changed",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.saved_panel.transferred",
        "description": "A saved panel was transferred to another owner",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.saved_panel.copied",
        "description": "A saved panel was copied",
        "readPermission": "zeteo.dashboards.read"
      },
      {
        "eventType": "zeteo.calendar.updated",
        "description": "The calendar's working days, holidays, fiscal year or time zone were changed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.measure.created",
        "description": "A measure was created",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.measure.updated",
        "description": "A measure was changed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.measure.deleted",
        "description": "A measure was deleted",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.measure_editors.updated",
        "description": "The people and groups who may change a source's measures were changed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.metric.created",
        "description": "A metric was created",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.metric.updated",
        "description": "A metric was changed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.metric.deleted",
        "description": "A metric was deleted",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.query.run",
        "description": "A query was run, refused or failed",
        "readPermission": "zeteo.runs.read"
      },
      {
        "eventType": "zeteo.export.started",
        "description": "An export started sending rows",
        "readPermission": "zeteo.runs.read"
      },
      {
        "eventType": "zeteo.export.run",
        "description": "An export ended, was refused or failed",
        "readPermission": "zeteo.runs.read"
      }
    ]
  }
}
