{
  "version": "0.0.0",
  "service": {
    "slug": "zeteo",
    "name": "Zeteo",
    "secretFrom": "TEREO_CLIENT_SECRET",
    "access": {
      "roles": [
        "audit_writer"
      ]
    },
    "permissions": [
      {
        "name": "zeteo.sources.read",
        "displayName": "Read sources",
        "description": "List and read the sources zeteo knows about",
        "orgAssignable": false
      },
      {
        "name": "zeteo.sources.write",
        "displayName": "Manage sources",
        "description": "Register, change, archive and refresh sources, and declare relations; also grants Read sources",
        "orgAssignable": false
      }
    ],
    "systemRoles": [
      {
        "name": "zeteo_admin",
        "displayName": "Zeteo administrator",
        "description": "Manages sources",
        "permissions": [
          "zeteo.sources.read",
          "zeteo.sources.write"
        ]
      }
    ],
    "eventTypes": [
      {
        "eventType": "zeteo.source.created",
        "description": "A source was registered",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.updated",
        "description": "A source's settings, limits or descriptions were changed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.archived",
        "description": "A source was archived",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.source.refreshed",
        "description": "A source's catalogue was refreshed",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.relation.declared",
        "description": "A relation was declared between two tables",
        "readPermission": "zeteo.sources.read"
      },
      {
        "eventType": "zeteo.relation.removed",
        "description": "A declared relation was removed",
        "readPermission": "zeteo.sources.read"
      }
    ]
  }
}
