{
  "name": "zeteo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "../../docker/test/run.sh",
    "tereo:provisioning": "tsx scripts/tereo-provisioning.ts",
    "openapi:lint": "redocly lint",
    "openapi:build": "redocly lint && redocly bundle",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:local": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:logs": "../../docker/test/run.sh logs -f runner",
    "test:clean": "../../docker/test/run.sh down -v",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tereo-io/mcp": "^0.1.0",
    "@tereo-io/sdk": "^0.5.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.9",
    "mssql": "^12.7.14",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@redocly/cli": "^2.78.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
