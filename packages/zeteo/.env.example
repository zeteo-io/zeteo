# Copy to .env for `npm run dev` and local test runs.

# Matches docker-compose.yml's postgres/redis on their host ports.
DATABASE_URL=postgresql://zeteo:zeteo@localhost:5462/zeteo
REDIS_URL=redis://localhost:6409
PUBLIC_URL=http://localhost:4201

# Wraps the keys that encrypt each source's connection settings. Exactly 32
# random bytes, base64url; the service refuses to start without one (outside
# NODE_ENV=test). Generate one per deploy and keep it: sources sealed under a
# lost key cannot be read again.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ZETEO_MASTER_KEY=replace-with-43-characters-generated-by-the-command-above

# Where sources may connect, comma separated: hostnames, *.suffix, IPs and
# CIDRs. Empty (the default) means no source can be added. Link-local (incl.
# cloud metadata), unspecified and multicast addresses are refused whatever
# this lists; loopback and private ranges only when listed. Not settable
# through the API.
# SOURCE_ALLOWED_HOSTS=db.internal,*.db.internal,10.0.0.0/8
# Local development only: loopback. Do not copy this into a deploy.
# SOURCE_ALLOWED_HOSTS=127.0.0.0/8,::1/128,localhost

# Database limits (defaults shown). A transaction that cannot start or runs
# out of time, or a lock wait past DB_LOCK_TIMEOUT_MS (which must stay below
# DB_TRANSACTION_TIMEOUT_MS), answers 503 temporarily_unavailable.
# DB_POOL_MAX=10
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_TRANSACTION_MAX_WAIT_MS=5000
# DB_TRANSACTION_TIMEOUT_MS=10000
# DB_LOCK_TIMEOUT_MS=5000

# Days a query or export run is kept in query_runs (0 keeps them all).
# QUERY_RUNS_RETENTION_DAYS=90

# Queries (1 to 100) and exports (1 to 10) one user may run at once across
# every replica (defaults shown). Each source has its own
# query_concurrency and export_concurrency as well.
# USER_QUERY_CONCURRENCY=5
# USER_EXPORT_CONCURRENCY=1

# The SQL Server the Azure SQL tests use (docker-compose.yml's `mssql`); this
# is the default.
# TEST_MSSQL_URL=mssql://sa:Zeteo-test-1@localhost:1463

# Local runs skip the tereo connection and accept SDK test tokens. Refused in
# production, where TEREO_URL, TEREO_CLIENT_ID, TEREO_CLIENT_SECRET and
# REQUEST_HANDLER_KEY are required instead.
TEREO_TEST_MODE=true

# MCP: the OAuth client ids of the AI connectors (one login client per AI,
# created in tereo), comma separated. Empty (the default) turns MCP off and
# /mcp is not served. Each user also needs the zeteo.mcp.use permission.
# /mcp accepts only PUBLIC_URL's host (https outside loopback), and reads
# tereo's sign-in metadata from TEREO_URL at start.
# MCP_ALLOWED_CLIENTS=claude-connector,chatgpt-connector
# Browser origins allowed to call /mcp; any other Origin is refused. Requests
# without an Origin (an AI's own servers) are not checked.
# MCP_ALLOWED_ORIGINS=https://app.example.com
# Tool calls per user per minute, across every replica (default shown).
# MCP_RATE_LIMIT_PER_MINUTE=120
