// One schema for all of Zeteo. `zeteo` holds the service's own data; `core`
// holds the tereo SDK's outbox.
//
// Migrations are generated by `prisma migrate dev --create-only`. Features
// Prisma cannot express — partial indexes, CHECK constraints — are appended
// as raw SQL to the generated migration.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["zeteo", "core"]
}

// ===========================================================================
// core
// ===========================================================================

// The @tereo-io/sdk outbox (docs/outbox.md). The reaper's SQL is hard-coded to
// these columns: do not rename them.
model CoreOutbox {
  id             String    @id @db.Uuid
  destination    String    @db.VarChar(64)
  payload        Json
  traceparent    String?   @db.VarChar(64)
  tracestate     String?   @db.VarChar(512)
  createdAt      DateTime  @default(now()) @map("created_at")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  claimedAt      DateTime? @map("claimed_at")
  claimedBy      String?   @map("claimed_by") @db.VarChar(255)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(1000)
  deadLetteredAt DateTime? @map("dead_lettered_at")

  // Raw SQL in the init migration, as @tereo-io/sdk's outboxTableSql:
  // core_outbox_pending_idx (next_attempt_at) WHERE dead_lettered_at IS NULL.
  @@map("core_outbox")
  @@schema("core")
}

// ===========================================================================
// zeteo: sources and catalogue
// ===========================================================================

enum SourceType {
  postgres
  azure_sql @map("azure-sql")
  upload

  @@map("source_type")
  @@schema("zeteo")
}

enum SourceStatus {
  active
  unreachable

  @@map("source_status")
  @@schema("zeteo")
}

enum TableKind {
  table
  view

  @@map("table_kind")
  @@schema("zeteo")
}

enum ColumnType {
  text
  number
  boolean
  date
  timestamp
  json
  other

  @@map("column_type")
  @@schema("zeteo")
}

enum RelationOrigin {
  discovered
  declared

  @@map("relation_origin")
  @@schema("zeteo")
}

// A registered database, or an upload source (type upload, owned by one user).
// Archived, never deleted. CHECK constraints in the migrations: owner_id is set
// exactly when type is upload; slug format, timeout_ms, row_cap, max_joins, export_row_cap,
// query_concurrency and export_concurrency ranges.
model Source {
  id                   String       @id @default(uuid(7)) @db.Uuid
  slug                 String       @unique
  name                 String
  // What the source holds, for the people and the AI that query it.
  description          String       @default("")
  type                 SourceType
  sealedSettings       Json         @map("sealed_settings")
  schemas              String[]
  timeoutMs            Int          @default(30000) @map("timeout_ms")
  rowCap               Int          @default(50000) @map("row_cap")
  maxJoins             Int          @default(4) @map("max_joins")
  exportEnabled        Boolean      @default(false) @map("export_enabled")
  exportRowCap         Int          @default(0) @map("export_row_cap")
  queryConcurrency     Int          @default(5) @map("query_concurrency")
  exportConcurrency    Int          @default(2) @map("export_concurrency")
  writableLoginAllowed Boolean      @default(false) @map("writable_login_allowed")
  status               SourceStatus @default(active)
  lastRefreshedAt      DateTime?    @map("last_refreshed_at") @db.Timestamp(3)
  // A database source's tables on disk at its last refresh; null for a file
  // source, or when the source would not tell.
  sizeBytes            BigInt?      @map("size_bytes")
  sizeMeasuredAt       DateTime?    @map("size_measured_at") @db.Timestamp(3)
  ownerId              String?      @map("owner_id") @db.Uuid
  createdBy            String       @map("created_by") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)
  archivedAt           DateTime?    @map("archived_at") @db.Timestamp(3)
  // An upload source with Google Sheets tables: how often they are synced (15
  // to 1440 minutes; null for a database source), and the source's last sync
  // attempt and its error summary, if it failed.
  syncIntervalMinutes  Int?         @map("sync_interval_minutes")
  lastSyncAttemptAt    DateTime?    @map("last_sync_attempt_at") @db.Timestamp(3)
  lastSyncError        Json?        @map("last_sync_error")

  tables         SourceTable[]
  relations      Relation[]
  runs           QueryRun[]
  savedQueries   SavedQuery[]
  uploadClaims   UploadClaim[]
  measures       Measure[]
  measureEditors MeasureEditor[]

  @@index([ownerId])
  @@map("sources")
  @@schema("zeteo")
}

model SourceTable {
  id                String    @id @default(uuid(7)) @db.Uuid
  sourceId          String    @map("source_id") @db.Uuid
  schemaName        String    @map("schema_name")
  name              String
  kind              TableKind
  description       String?
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamp(3)
  missingSince      DateTime? @map("missing_since") @db.Timestamp(3)
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamp(3)
  // An upload source's table: its rows at its last load. A database source's:
  // the database's estimate at the last refresh, null when it gave none.
  rowCount          BigInt?   @map("row_count")
  // An upload source's table: where it comes from (`TableOrigin` in
  // src/uploads/origin.ts: a file, a Google Sheets tab or a merged table).
  origin            Json?     @map("origin")
  // A Google Sheets table: its last sync attempt and its error, if it failed.
  lastSyncAttemptAt DateTime? @map("last_sync_attempt_at") @db.Timestamp(3)
  lastSyncError     Json?     @map("last_sync_error")

  source        Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  columns       SourceColumn[]
  relationsFrom Relation[]     @relation("RelationFrom")
  relationsTo   Relation[]     @relation("RelationTo")
  grants        Grant[]
  measures      Measure[]

  @@unique([sourceId, schemaName, name])
  @@map("source_tables")
  @@schema("zeteo")
}

model SourceColumn {
  id           String     @id @default(uuid(7)) @db.Uuid
  tableId      String     @map("table_id") @db.Uuid
  name         String
  type         ColumnType
  nativeType   String     @map("native_type")
  nullable     Boolean
  position     Int
  isPrimaryKey Boolean    @map("is_primary_key")
  description  String?
  originalName String?    @map("original_name")
  missingSince DateTime?  @map("missing_since") @db.Timestamp(3)

  table  SourceTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  grants GrantColumn[]

  @@unique([tableId, name])
  @@map("source_columns")
  @@schema("zeteo")
}

// CHECK constraint in the migration: from_columns and to_columns are the same
// length, at least one.
model Relation {
  id             String         @id @default(uuid(7)) @db.Uuid
  sourceId       String         @map("source_id") @db.Uuid
  name           String
  fromTableId    String         @map("from_table_id") @db.Uuid
  fromColumns    String[]       @map("from_columns")
  toTableId      String         @map("to_table_id") @db.Uuid
  toColumns      String[]       @map("to_columns")
  toMany         Boolean        @map("to_many")
  origin         RelationOrigin
  constraintName String?        @map("constraint_name")
  // Set when an admin renames a discovered relation: refreshes then leave the name alone.
  nameLocked     Boolean        @default(false) @map("name_locked")
  missingSince   DateTime?      @map("missing_since") @db.Timestamp(3)
  createdBy      String?        @map("created_by") @db.Uuid

  source    Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fromTable SourceTable @relation("RelationFrom", fields: [fromTableId], references: [id], onDelete: Cascade)
  toTable   SourceTable @relation("RelationTo", fields: [toTableId], references: [id], onDelete: Cascade)

  @@unique([fromTableId, name])
  @@index([sourceId])
  @@index([toTableId])
  @@map("relations")
  @@schema("zeteo")
}

// ===========================================================================
// zeteo: grants and query runs
// ===========================================================================

enum PrincipalType {
  user
  group

  @@map("principal_type")
  @@schema("zeteo")
}

enum EntryPoint {
  api
  mcp
  export
  dashboard

  @@map("entry_point")
  @@schema("zeteo")
}

enum RunOutcome {
  ok
  refused
  failed
  timeout
  // An export that has started and not yet ended.
  running

  @@map("run_outcome")
  @@schema("zeteo")
}

// What a user or group may query of one table. The principal is a tereo id, so
// it has no foreign key. A table or column with a grant cannot be deleted.
// CHECK constraint in the migration: row_filter IS NULL (reserved).
model Grant {
  id            String        @id @default(uuid(7)) @db.Uuid
  principalType PrincipalType @map("principal_type")
  principalId   String        @map("principal_id") @db.Uuid
  tableId       String        @map("table_id") @db.Uuid
  allColumns    Boolean       @map("all_columns")
  rowFilter     Json?         @map("row_filter")
  ownerGrant    Boolean       @default(false) @map("owner_grant")
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)

  table   SourceTable   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  columns GrantColumn[]

  @@unique([principalType, principalId, tableId])
  @@index([tableId])
  @@map("grants")
  @@schema("zeteo")
}

// An upload waiting to become an upload source (or to replace one's tables): the
// preview shown to its owner and the names of the staging tables holding its
// rows. Expires one hour after creation.
model UploadStaging {
  id           String   @id @default(uuid(7)) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  // "file" or "google-sheets".
  kind         String
  vendorFileId String?  @map("vendor_file_id")
  preview      Json
  tables       Json
  expiresAt    DateTime @map("expires_at") @db.Timestamp(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([expiresAt])
  @@index([ownerId])
  @@map("upload_stagings")
  @@schema("zeteo")
}

// A spreadsheet (or another vendor's file) backing tables of an upload source:
// one unarchived source at a time, the first to claim it.
model UploadClaim {
  vendor    String
  fileId    String   @map("file_id")
  sourceId  String   @map("source_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([vendor, fileId])
  @@index([sourceId])
  @@map("upload_claims")
  @@schema("zeteo")
}

// The service checks that the column belongs to the grant's table.
model GrantColumn {
  grantId  String @map("grant_id") @db.Uuid
  columnId String @map("column_id") @db.Uuid

  grant  Grant        @relation(fields: [grantId], references: [id], onDelete: Cascade)
  column SourceColumn @relation(fields: [columnId], references: [id], onDelete: Restrict)

  @@id([grantId, columnId])
  @@map("grant_columns")
  @@schema("zeteo")
}

// A user's or group's own concurrency limits, in place of the environment's
// defaults. The principal is a tereo id, so it has no foreign key.
// CHECK constraints in the migration: query_concurrency 1..100,
// export_concurrency 1..10, at least one of them set.
model PrincipalLimit {
  id                String        @id @default(uuid(7)) @db.Uuid
  principalType     PrincipalType @map("principal_type")
  principalId       String        @map("principal_id") @db.Uuid
  queryConcurrency  Int?          @map("query_concurrency")
  exportConcurrency Int?          @map("export_concurrency")
  createdBy         String        @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)

  @@unique([principalType, principalId])
  @@map("principal_limits")
  @@schema("zeteo")
}

// Every query that passed the shape check. source_id is null when the source
// did not resolve.
model QueryRun {
  id           String     @id @default(uuid(7)) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  sourceId     String?    @map("source_id") @db.Uuid
  entryPoint   EntryPoint @map("entry_point")
  query        Json
  durationMs   Int        @map("duration_ms")
  rowCount     Int?       @map("row_count")
  outcome      RunOutcome
  errorCode    String?    @map("error_code")
  truncated    Boolean    @default(false)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(3)
  savedQueryId String?    @map("saved_query_id") @db.Uuid
  dashboardId  String?    @map("dashboard_id") @db.Uuid

  source     Source?     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  savedQuery SavedQuery? @relation(fields: [savedQueryId], references: [id], onDelete: SetNull)
  dashboard  Dashboard?  @relation(fields: [dashboardId], references: [id], onDelete: SetNull)

  @@index([userId, id])
  @@index([sourceId, id])
  @@index([savedQueryId])
  @@index([dashboardId])
  @@map("query_runs")
  @@schema("zeteo")
}

// ===========================================================================
// Saved queries
// ===========================================================================

model SavedQuery {
  id          String    @id @default(uuid(7)) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  sourceId    String    @map("source_id") @db.Uuid
  name        String
  description String    @default("")
  query       Json
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamp(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  availableForDashboards  Boolean @default(false) @map("available_for_dashboards")
  availableOrganizationId String? @map("available_organization_id") @db.Uuid

  source      Source              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  shares      SavedQueryShare[]
  userRuns    SavedQueryUserRun[]
  runs        QueryRun[]
  panels      DashboardPanel[]
  savedPanels SavedPanel[]

  @@index([ownerId])
  @@index([sourceId])
  @@index([availableForDashboards, availableOrganizationId])
  @@map("saved_queries")
  @@schema("zeteo")
}

model SavedQueryShare {
  savedQueryId  String        @map("saved_query_id") @db.Uuid
  principalType PrincipalType @map("principal_type")
  principalId   String        @map("principal_id") @db.Uuid
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(3)

  savedQuery SavedQuery @relation(fields: [savedQueryId], references: [id], onDelete: Cascade)

  @@id([savedQueryId, principalType, principalId])
  @@index([principalType, principalId])
  @@map("saved_query_shares")
  @@schema("zeteo")
}

model SavedQueryUserRun {
  savedQueryId String   @map("saved_query_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  lastRunAt    DateTime @map("last_run_at") @db.Timestamp(3)

  savedQuery SavedQuery @relation(fields: [savedQueryId], references: [id], onDelete: Cascade)

  @@id([savedQueryId, userId])
  @@map("saved_query_user_runs")
  @@schema("zeteo")
}

// ===========================================================================
// Dashboards
// ===========================================================================

enum DashboardTheme {
  light
  dark
  auto

  @@map("dashboard_theme")
  @@schema("zeteo")
}

enum PanelKind {
  own
  linked

  @@map("panel_kind")
  @@schema("zeteo")
}

model Dashboard {
  id             String         @id @default(uuid(7)) @db.Uuid
  ownerId        String         @map("owner_id") @db.Uuid
  name           String
  description    String         @default("")
  timeRange      String?        @map("time_range")
  refreshSeconds Int?           @map("refresh_seconds")
  theme          DashboardTheme @default(auto)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamp(3)

  panels DashboardPanel[]
  shares DashboardShare[]
  runs   QueryRun[]

  @@index([ownerId])
  @@map("dashboards")
  @@schema("zeteo")
}

model DashboardPanel {
  id           String    @id @default(uuid(7)) @db.Uuid
  dashboardId  String    @map("dashboard_id") @db.Uuid
  kind         PanelKind
  x            Int
  y            Int
  w            Int
  h            Int
  title        String?
  savedQueryId String?   @map("saved_query_id") @db.Uuid
  savedPanelId String?   @map("saved_panel_id") @db.Uuid
  chart        Json?
  timeColumn   String?   @map("time_column")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  dashboard  Dashboard   @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  savedQuery SavedQuery? @relation(fields: [savedQueryId], references: [id], onDelete: SetNull)
  savedPanel SavedPanel? @relation(fields: [savedPanelId], references: [id], onDelete: SetNull)

  @@index([dashboardId])
  @@index([savedQueryId])
  @@index([savedPanelId])
  @@map("dashboard_panels")
  @@schema("zeteo")
}

model DashboardShare {
  dashboardId   String        @map("dashboard_id") @db.Uuid
  principalType PrincipalType @map("principal_type")
  principalId   String        @map("principal_id") @db.Uuid
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(3)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@id([dashboardId, principalType, principalId])
  @@index([principalType, principalId])
  @@map("dashboard_shares")
  @@schema("zeteo")
}

model SavedPanel {
  id           String   @id @default(uuid(7)) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  name         String
  description  String   @default("")
  savedQueryId String?  @map("saved_query_id") @db.Uuid
  chart        Json
  timeColumn   String?  @map("time_column")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  savedQuery SavedQuery?       @relation(fields: [savedQueryId], references: [id], onDelete: SetNull)
  shares     SavedPanelShare[]
  panels     DashboardPanel[]

  @@index([ownerId])
  @@index([savedQueryId])
  @@map("saved_panels")
  @@schema("zeteo")
}

model SavedPanelShare {
  savedPanelId  String        @map("saved_panel_id") @db.Uuid
  principalType PrincipalType @map("principal_type")
  principalId   String        @map("principal_id") @db.Uuid
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(3)

  savedPanel SavedPanel @relation(fields: [savedPanelId], references: [id], onDelete: Cascade)

  @@id([savedPanelId, principalType, principalId])
  @@index([principalType, principalId])
  @@map("saved_panel_shares")
  @@schema("zeteo")
}

// A vendor connection Zeteo syncs from, one row per provider (`google`).
model Connection {
  provider       String   @id
  sealedSettings Json     @map("sealed_settings")
  updatedBy      String   @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("connections")
  @@schema("zeteo")
}

// The one calendar of the deployment (a single row, id = 1; no row means the
// defaults). CHECK constraints in the migration: id = 1,
// fiscal_year_start_month 1..12.
model Calendar {
  id                   Int      @id
  workingDays          Int[]    @map("working_days")
  fiscalYearStartMonth Int      @map("fiscal_year_start_month")
  timeZone             String   @map("time_zone")
  updatedBy            String?  @map("updated_by") @db.Uuid
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamp(3)

  @@map("calendar")
  @@schema("zeteo")
}

model CalendarHoliday {
  date DateTime @id @db.Date
  name String

  @@map("calendar_holidays")
  @@schema("zeteo")
}

// A named group-level expression on one home table of a source. CHECK in the
// migration: description is 1..2000 characters.
model Measure {
  id          String   @id @default(uuid(7)) @db.Uuid
  sourceId    String   @map("source_id") @db.Uuid
  tableId     String   @map("table_id") @db.Uuid
  name        String
  description String
  formula     Json
  where       Json?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedBy   String   @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  source Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  table  SourceTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([sourceId, name])
  @@index([tableId])
  @@map("measures")
  @@schema("zeteo")
}

// Who besides the admins may change a source's measures.
model MeasureEditor {
  sourceId      String        @map("source_id") @db.Uuid
  principalType PrincipalType @map("principal_type")
  principalId   String        @map("principal_id") @db.Uuid
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(3)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([sourceId, principalType, principalId])
  @@map("measure_editors")
  @@schema("zeteo")
}
