// One schema for all of Zeteo. `zeteo` holds the service's own data (its
// tables arrive with the features that need them); `core` holds the tereo
// SDK's outbox.
//
// Migrations are generated by `prisma migrate dev --create-only`. Features
// Prisma cannot express — partial indexes, CHECK constraints — are appended
// as raw SQL to the generated migration.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["zeteo", "core"]
}

// ===========================================================================
// core
// ===========================================================================

// The @tereo-io/sdk outbox (docs/outbox.md). The reaper's SQL is hard-coded to
// these columns: do not rename them.
model CoreOutbox {
  id             String    @id @db.Uuid
  destination    String    @db.VarChar(64)
  payload        Json
  traceparent    String?   @db.VarChar(64)
  tracestate     String?   @db.VarChar(512)
  createdAt      DateTime  @default(now()) @map("created_at")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  claimedAt      DateTime? @map("claimed_at")
  claimedBy      String?   @map("claimed_by") @db.VarChar(255)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(1000)
  deadLetteredAt DateTime? @map("dead_lettered_at")

  // Raw SQL in the init migration, as @tereo-io/sdk's outboxTableSql:
  // core_outbox_pending_idx (next_attempt_at) WHERE dead_lettered_at IS NULL.
  @@map("core_outbox")
  @@schema("core")
}
