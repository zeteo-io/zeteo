// One schema for all of Zeteo. `zeteo` holds the service's own data; `core`
// holds the tereo SDK's outbox.
//
// Migrations are generated by `prisma migrate dev --create-only`. Features
// Prisma cannot express — partial indexes, CHECK constraints — are appended
// as raw SQL to the generated migration.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["zeteo", "core"]
}

// ===========================================================================
// core
// ===========================================================================

// The @tereo-io/sdk outbox (docs/outbox.md). The reaper's SQL is hard-coded to
// these columns: do not rename them.
model CoreOutbox {
  id             String    @id @db.Uuid
  destination    String    @db.VarChar(64)
  payload        Json
  traceparent    String?   @db.VarChar(64)
  tracestate     String?   @db.VarChar(512)
  createdAt      DateTime  @default(now()) @map("created_at")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  claimedAt      DateTime? @map("claimed_at")
  claimedBy      String?   @map("claimed_by") @db.VarChar(255)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(1000)
  deadLetteredAt DateTime? @map("dead_lettered_at")

  // Raw SQL in the init migration, as @tereo-io/sdk's outboxTableSql:
  // core_outbox_pending_idx (next_attempt_at) WHERE dead_lettered_at IS NULL.
  @@map("core_outbox")
  @@schema("core")
}

// ===========================================================================
// zeteo: sources and catalogue
// ===========================================================================

enum SourceType {
  postgres
  azure_sql @map("azure-sql")

  @@map("source_type")
  @@schema("zeteo")
}

enum SourceStatus {
  active
  unreachable

  @@map("source_status")
  @@schema("zeteo")
}

enum TableKind {
  table
  view

  @@map("table_kind")
  @@schema("zeteo")
}

enum ColumnType {
  text
  number
  boolean
  date
  timestamp
  json
  other

  @@map("column_type")
  @@schema("zeteo")
}

enum RelationOrigin {
  discovered
  declared

  @@map("relation_origin")
  @@schema("zeteo")
}

// A registered database. Archived, never deleted. CHECK constraints in the
// migration: slug format, timeout_ms, row_cap and export_row_cap ranges.
model Source {
  id                   String       @id @default(uuid(7)) @db.Uuid
  slug                 String       @unique
  name                 String
  type                 SourceType
  sealedSettings       Json         @map("sealed_settings")
  schemas              String[]
  timeoutMs            Int          @default(30000) @map("timeout_ms")
  rowCap               Int          @default(50000) @map("row_cap")
  exportEnabled        Boolean      @default(false) @map("export_enabled")
  exportRowCap         Int          @default(0) @map("export_row_cap")
  writableLoginAllowed Boolean      @default(false) @map("writable_login_allowed")
  status               SourceStatus @default(active)
  lastRefreshedAt      DateTime?    @map("last_refreshed_at") @db.Timestamp(3)
  createdBy            String       @map("created_by") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)
  archivedAt           DateTime?    @map("archived_at") @db.Timestamp(3)

  tables    SourceTable[]
  relations Relation[]
  runs      QueryRun[]

  @@map("sources")
  @@schema("zeteo")
}

model SourceTable {
  id           String    @id @default(uuid(7)) @db.Uuid
  sourceId     String    @map("source_id") @db.Uuid
  schemaName   String    @map("schema_name")
  name         String
  kind         TableKind
  description  String?
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamp(3)
  missingSince DateTime? @map("missing_since") @db.Timestamp(3)

  source        Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  columns       SourceColumn[]
  relationsFrom Relation[]     @relation("RelationFrom")
  relationsTo   Relation[]     @relation("RelationTo")
  grants        Grant[]

  @@unique([sourceId, schemaName, name])
  @@map("source_tables")
  @@schema("zeteo")
}

model SourceColumn {
  id           String     @id @default(uuid(7)) @db.Uuid
  tableId      String     @map("table_id") @db.Uuid
  name         String
  type         ColumnType
  nativeType   String     @map("native_type")
  nullable     Boolean
  position     Int
  isPrimaryKey Boolean    @map("is_primary_key")
  description  String?
  missingSince DateTime?  @map("missing_since") @db.Timestamp(3)

  table  SourceTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  grants GrantColumn[]

  @@unique([tableId, name])
  @@map("source_columns")
  @@schema("zeteo")
}

// CHECK constraint in the migration: from_columns and to_columns are the same
// length, at least one.
model Relation {
  id             String         @id @default(uuid(7)) @db.Uuid
  sourceId       String         @map("source_id") @db.Uuid
  name           String
  fromTableId    String         @map("from_table_id") @db.Uuid
  fromColumns    String[]       @map("from_columns")
  toTableId      String         @map("to_table_id") @db.Uuid
  toColumns      String[]       @map("to_columns")
  toMany         Boolean        @map("to_many")
  origin         RelationOrigin
  constraintName String?        @map("constraint_name")
  missingSince   DateTime?      @map("missing_since") @db.Timestamp(3)
  createdBy      String?        @map("created_by") @db.Uuid

  source    Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fromTable SourceTable @relation("RelationFrom", fields: [fromTableId], references: [id], onDelete: Cascade)
  toTable   SourceTable @relation("RelationTo", fields: [toTableId], references: [id], onDelete: Cascade)

  @@unique([fromTableId, name])
  @@index([sourceId])
  @@index([toTableId])
  @@map("relations")
  @@schema("zeteo")
}

// ===========================================================================
// zeteo: grants and query runs
// ===========================================================================

enum PrincipalType {
  user
  group

  @@map("principal_type")
  @@schema("zeteo")
}

enum EntryPoint {
  api
  mcp
  export

  @@map("entry_point")
  @@schema("zeteo")
}

enum RunOutcome {
  ok
  refused
  failed
  timeout
  // An export that has started and not yet ended.
  running

  @@map("run_outcome")
  @@schema("zeteo")
}

// What a user or group may query of one table. The principal is a tereo id, so
// it has no foreign key. A table or column with a grant cannot be deleted.
// CHECK constraint in the migration: row_filter IS NULL (reserved).
model Grant {
  id            String        @id @default(uuid(7)) @db.Uuid
  principalType PrincipalType @map("principal_type")
  principalId   String        @map("principal_id") @db.Uuid
  tableId       String        @map("table_id") @db.Uuid
  allColumns    Boolean       @map("all_columns")
  rowFilter     Json?         @map("row_filter")
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)

  table   SourceTable   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  columns GrantColumn[]

  @@unique([principalType, principalId, tableId])
  @@index([tableId])
  @@map("grants")
  @@schema("zeteo")
}

// The service checks that the column belongs to the grant's table.
model GrantColumn {
  grantId  String @map("grant_id") @db.Uuid
  columnId String @map("column_id") @db.Uuid

  grant  Grant        @relation(fields: [grantId], references: [id], onDelete: Cascade)
  column SourceColumn @relation(fields: [columnId], references: [id], onDelete: Restrict)

  @@id([grantId, columnId])
  @@map("grant_columns")
  @@schema("zeteo")
}

// Every query that passed the shape check. source_id is null when the source
// did not resolve.
model QueryRun {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  sourceId   String?    @map("source_id") @db.Uuid
  entryPoint EntryPoint @map("entry_point")
  query      Json
  durationMs Int        @map("duration_ms")
  rowCount   Int?       @map("row_count")
  outcome    RunOutcome
  errorCode  String?    @map("error_code")
  truncated  Boolean    @default(false)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamp(3)

  source Source? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([userId, id])
  @@index([sourceId, id])
  @@map("query_runs")
  @@schema("zeteo")
}
