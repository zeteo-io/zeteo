{
  "name": "@zeteo-io/sdk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/zeteo-sdk/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc",
        "cwd": "packages/zeteo-sdk"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/zeteo-sdk"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "vitest run",
        "cwd": "packages/zeteo-sdk"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist tsconfig.tsbuildinfo",
        "cwd": "packages/zeteo-sdk"
      }
    }
  }
}
