{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    // The browser test's page.evaluate callbacks run in the page.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["**/*.ts"]
}
