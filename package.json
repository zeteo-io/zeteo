{
  "name": "zeteo",
  "version": "0.1.0",
  "description": "A query service for apps built on tereo — admins register databases as sources and grant tables and columns to tereo users and groups; people query through a validated JSON query language over HTTP or MCP",
  "author": "Aaron Leman",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/js": "23.3.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^25.9.9",
    "eslint": "^10.12.0",
    "nx": "23.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "ioredis": "^6.0.0",
    "nx": {
      "undici": "^7.29.1"
    },
    "prisma": {
      "mysql2": "^3.24.6"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  },
  "engines": {
    "node": "22.x.x"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false
  },
  "scripts": {
    "format": "prettier --write --no-error-on-unmatched-pattern \"packages/*/src/**/*.{ts,tsx,js,jsx,css}\" scripts",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"packages/*/src/**/*.{ts,tsx,js,jsx,css}\" scripts",
    "lint": "eslint --no-error-on-unmatched-pattern packages/ scripts/ && { ls packages/*/package.json >/dev/null 2>&1 || exit 0; npm run lint --workspaces --if-present; }",
    "sort-imports": "tsx scripts/sort-imports.ts",
    "sort-imports:check": "tsx scripts/sort-imports.ts --check",
    "check": "nx run-many -t check",
    "version-plan": "nx release plan"
  }
}
